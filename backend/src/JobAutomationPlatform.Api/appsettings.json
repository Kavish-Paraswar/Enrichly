{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Enrichly",
    "Audience": "Enrichly",
    "SigningKey": "",
    "TokenMinutes": 720
  },
  "Session": {
    "SessionDays": 7
  },
  "Worker": {
    "PollingIntervalSeconds": 5,
    "HeartbeatIntervalSeconds": 5,
    "StaleAfterMinutes": 2,
    "RetryBaseDelaySeconds": 30,
    "RetryMaxDelaySeconds": 600,
    "SchedulerIntervalSeconds": 15
  }
}
