{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "AllowedHosts": "*",
  "Worker": {
    "PollingIntervalSeconds": 5,
    "HeartbeatIntervalSeconds": 5,
    "StaleAfterMinutes": 2,
    "RetryDelaySeconds": 30,
    "SchedulerIntervalSeconds": 15
  }
}
