POSTGRES_DB=job_automation
POSTGRES_USER=job_automation
POSTGRES_PASSWORD=job_automation_dev
POSTGRES_PORT=5432

ConnectionStrings__Default=Host=postgres;Port=5432;Database=job_automation;Username=job_automation;Password=job_automation_dev
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
Worker__PollingIntervalSeconds=5
Worker__HeartbeatIntervalSeconds=5
Worker__StaleAfterMinutes=2
Worker__RetryBaseDelaySeconds=30
Worker__RetryMaxDelaySeconds=600
Worker__SchedulerIntervalSeconds=15

Jwt__Issuer=Enrichly
Jwt__Audience=Enrichly
Jwt__SigningKey=replace-with-a-long-random-secret-at-least-32-chars
Jwt__TokenMinutes=720

Session__SessionDays=7

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_TELEMETRY_DISABLED=1
